generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WorkspacePrincipal {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String   @default("better_auth") @db.Text
  providerSubject String   @unique(map: "workspace_principals_provider_subject_key") @map("provider_subject") @db.Text
  kind            String   @db.Text
  status          String   @default("active") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clientMemberships   WorkspaceClientMembership[]
  staffMembership     WorkspaceStaffMembership?
  redeemedInvitations WorkspaceInvitationRecord[] @relation("InvitationRedeemer")
  auditEvents         WorkspaceAuditEvent[]

  @@unique([id, kind], map: "workspace_principal_kind_uq")
  @@map("workspace_principals")
}

model WorkspaceTenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName String   @map("legal_name") @db.Text
  status    String   @default("active") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clientMemberships WorkspaceClientMembership[]
  projects          WorkspaceProject[]

  @@map("workspace_tenants")
}

model WorkspaceClientMembership {
  tenantId      String    @map("tenant_id") @db.Uuid
  principalId   String    @map("principal_id") @db.Uuid
  principalKind String    @default("client") @map("principal_kind") @db.Text
  status        String    @default("active") @db.Text
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant    WorkspaceTenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "workspace_client_memberships_tenant_id_fkey")
  principal WorkspacePrincipal            @relation(fields: [principalId, principalKind], references: [id, kind], onDelete: Restrict, map: "workspace_client_memberships_principal_id_principal_kind_fkey")
  grants    WorkspaceClientProjectGrant[]

  @@id([tenantId, principalId])
  @@map("workspace_client_memberships")
}

model WorkspaceStaffMembership {
  principalId   String    @id @map("principal_id") @db.Uuid
  principalKind String    @default("staff") @map("principal_kind") @db.Text
  status        String    @default("active") @db.Text
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  principal   WorkspacePrincipal           @relation(fields: [principalId, principalKind], references: [id, kind], onDelete: Restrict, map: "workspace_staff_memberships_principal_id_principal_kind_fkey")
  grants      WorkspaceStaffProjectGrant[]
  invitations WorkspaceInvitationRecord[]  @relation("InvitationIssuer")
  authoredShares WorkspaceSharedRevision[] @relation("SharedAuthors")
  reviewedShares WorkspaceSharedPublication[] @relation("SharedReviewers")
  retractedShares WorkspaceSharedRetraction[] @relation("SharedRetractors")

  @@unique([principalId, principalKind], map: "workspace_staff_membership_principal_kind_uq")
  @@map("workspace_staff_memberships")
}

model WorkspaceProject {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.Text
  state       String   @default("planned") @db.Text
  publication String   @default("unpublished") @db.Text
  revision    BigInt   @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       WorkspaceTenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "workspace_projects_tenant_id_fkey")
  clientGrants WorkspaceClientProjectGrant[]
  staffGrants  WorkspaceStaffProjectGrant[]
  invitations  WorkspaceInvitationRecord[]
  auditEvents  WorkspaceAuditEvent[]
  sharedRevisions WorkspaceSharedRevision[]

  @@unique([tenantId, id], map: "workspace_project_tenant_id_uq")
  @@index([tenantId, state], map: "workspace_project_tenant_state_idx")
  @@map("workspace_projects")
}

model WorkspaceClientProjectGrant {
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  role        String    @db.Text
  status      String    @default("active") @db.Text
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  project    WorkspaceProject          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, map: "workspace_client_project_grants_tenant_id_project_id_fkey")
  membership WorkspaceClientMembership @relation(fields: [tenantId, principalId], references: [tenantId, principalId], onDelete: Restrict, map: "workspace_client_project_grants_tenant_id_principal_id_fkey")

  @@id([tenantId, projectId, principalId, role])
  @@index([principalId, tenantId, projectId, status], map: "workspace_client_grants_active_idx")
  @@map("workspace_client_project_grants")
}

model WorkspaceStaffProjectGrant {
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  role        String    @db.Text
  status      String    @default("active") @db.Text
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  project    WorkspaceProject         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, map: "workspace_staff_project_grants_tenant_id_project_id_fkey")
  membership WorkspaceStaffMembership @relation(fields: [principalId], references: [principalId], onDelete: Restrict, map: "workspace_staff_project_grants_principal_id_fkey")

  @@id([tenantId, projectId, principalId, role])
  @@index([principalId, tenantId, projectId, status], map: "workspace_staff_grants_active_idx")
  @@map("workspace_staff_project_grants")
}

model WorkspaceInvitationRecord {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  intendedEmail         String    @map("intended_email") @db.Text
  intendedRole          String    @map("intended_role") @db.Text
  invitationTokenHash   String    @unique(map: "workspace_invitation_records_invitation_token_hash_key") @map("invitation_token_hash") @db.Text
  status                String    @default("pending") @db.Text
  issuedByStaffId       String    @map("issued_by_staff_id") @db.Uuid
  redeemedByClientId    String?   @map("redeemed_by_client_id") @db.Uuid
  redeemedPrincipalKind String    @default("client") @map("redeemed_principal_kind") @db.Text
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  redeemedAt            DateTime? @map("redeemed_at") @db.Timestamptz(6)

  project    WorkspaceProject         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, map: "workspace_invitation_records_tenant_id_project_id_fkey")
  issuer     WorkspaceStaffMembership @relation("InvitationIssuer", fields: [issuedByStaffId], references: [principalId], onDelete: Restrict, map: "workspace_invitation_records_issued_by_staff_id_fkey")
  redeemedBy WorkspacePrincipal?      @relation("InvitationRedeemer", fields: [redeemedByClientId, redeemedPrincipalKind], references: [id, kind], onDelete: Restrict, map: "workspace_invites_redeemed_principal_kind_fkey")
  enrollmentAttempts WorkspaceEnrollmentAttempt[]

  @@unique([tenantId, projectId, id], map: "workspace_invitation_scope_uq")
  @@map("workspace_invitation_records")
}

// Durable workspace-side saga journal. Better Auth identity/session rows stay
// in auth_spike; this table stores only the stable subject and hashed proof refs.
model WorkspaceEnrollmentAttempt {
  id                 String    @id @db.Uuid
  idempotencyHash    String    @unique(map: "workspace_enrollment_idempotency_hash_key") @map("idempotency_hash") @db.Text
  invitationId       String    @unique(map: "workspace_enrollment_invitation_id_key") @map("invitation_id") @db.Uuid
  invitationHash     String    @map("invitation_hash") @db.Text
  mailboxProofRefHash String   @map("mailbox_proof_ref_hash") @db.Text
  providerSubject    String    @unique(map: "workspace_enrollment_provider_subject_key") @map("provider_subject") @db.Text
  tenantId           String    @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  intendedEmail      String    @map("intended_email") @db.Text
  intendedRole       String    @map("intended_role") @db.Text
  state              String    @default("pending") @db.Text
  attemptCount       Int       @default(0) @map("attempt_count")
  lastErrorCode      String?   @map("last_error_code") @db.Text
  nextRetryAt        DateTime? @map("next_retry_at") @db.Timestamptz(6)
  poisonedAt         DateTime? @map("poisoned_at") @db.Timestamptz(6)
  authCreatedAt      DateTime? @map("auth_created_at") @db.Timestamptz(6)
  principalCreatedAt DateTime? @map("principal_created_at") @db.Timestamptz(6)
  grantApprovedAt    DateTime? @map("grant_approved_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  invitation WorkspaceInvitationRecord @relation(fields: [tenantId, projectId, invitationId], references: [tenantId, projectId, id], onDelete: Restrict, map: "workspace_enrollment_invitation_scope_fkey")

  @@index([state, nextRetryAt, updatedAt], map: "workspace_enrollment_retry_idx")
  @@index([poisonedAt], map: "workspace_enrollment_poisoned_idx")
  @@map("workspace_enrollment_attempts")
}

model WorkspaceAuditEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  actorPrincipalId String?  @map("actor_principal_id") @db.Uuid
  origin           String   @db.Text
  action           String   @db.Text
  objectType       String   @map("object_type") @db.Text
  objectId         String   @map("object_id") @db.Text
  beforeRevision   BigInt?  @map("before_revision")
  afterRevision    BigInt?  @map("after_revision")
  idempotencyKey   String   @map("idempotency_key") @db.Text
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  project WorkspaceProject    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, map: "workspace_audit_events_tenant_id_project_id_fkey")
  actor   WorkspacePrincipal? @relation(fields: [actorPrincipalId], references: [id], onDelete: Restrict, map: "workspace_audit_events_actor_principal_id_fkey")
  sharedPublications WorkspaceSharedPublication[] @relation("SharingPublishedAudit")
  sharedRetractions WorkspaceSharedRetraction[] @relation("SharingRetractedAudit")

  @@unique([tenantId, idempotencyKey], map: "workspace_audit_command_once")
  @@unique([tenantId, projectId, id], map: "workspace_audit_scope_uq")
  @@index([tenantId, projectId, occurredAt(sort: Desc)], map: "workspace_audit_project_time_idx")
  @@map("workspace_audit_events")
}


// Development-only immutable sharing ledger. There is no live route, approved
// storage, reader grant or customer-facing endpoint attached to these models.
model WorkspaceSharedRevision {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  resourceId        String   @map("resource_id") @db.Uuid
  version           Int
  kind              String   @db.Text
  title             String   @db.Text
  summary           String   @db.Text
  privateObjectRef  String?  @map("private_object_ref") @db.Text
  contentSha256     String   @map("content_sha256") @db.Text
  byteSize          BigInt?  @map("byte_size")
  mediaType         String?  @map("media_type") @db.Text
  createdByStaffId  String   @map("created_by_staff_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project      WorkspaceProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict, map: "workspace_shared_revisions_project_fkey")
  author       WorkspaceStaffMembership @relation("SharedAuthors", fields: [createdByStaffId], references: [principalId], onDelete: Restrict, map: "workspace_shared_revisions_author_fkey")
  publications WorkspaceSharedPublication[]

  @@unique([tenantId, projectId, id], map: "workspace_shared_revisions_scope_uq")
  @@unique([tenantId, projectId, resourceId, version], map: "workspace_shared_resource_version_uq")
  @@index([tenantId, projectId, kind, createdAt(sort: Desc)], map: "workspace_shared_draft_idx")
  @@map("workspace_shared_revisions")
}

model WorkspaceSharedPublication {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  revisionId      String   @unique(map: "workspace_shared_publications_revision_id_key") @map("revision_id") @db.Uuid
  reviewedByStaffId String @map("reviewed_by_staff_id") @db.Uuid
  auditEventId    String   @unique(map: "workspace_shared_publications_audit_event_id_key") @map("audit_event_id") @db.Uuid
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  revision    WorkspaceSharedRevision @relation(fields: [tenantId, projectId, revisionId], references: [tenantId, projectId, id], onDelete: Restrict, map: "workspace_shared_publications_revision_scope_fkey")
  reviewer    WorkspaceStaffMembership @relation("SharedReviewers", fields: [reviewedByStaffId], references: [principalId], onDelete: Restrict, map: "workspace_shared_publications_reviewer_fkey")
  audit       WorkspaceAuditEvent @relation("SharingPublishedAudit", fields: [tenantId, projectId, auditEventId], references: [tenantId, projectId, id], onDelete: Restrict, map: "workspace_shared_publications_audit_scope_fkey")
  retractions WorkspaceSharedRetraction[]

  @@unique([tenantId, projectId, id], map: "workspace_shared_publications_scope_uq")
  @@index([tenantId, projectId, publishedAt(sort: Desc)], map: "workspace_shared_publications_project_time_idx")
  @@map("workspace_shared_publications")
}

model WorkspaceSharedRetraction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  publicationId    String   @unique(map: "workspace_shared_retractions_publication_id_key") @map("publication_id") @db.Uuid
  retractedByStaffId String @map("retracted_by_staff_id") @db.Uuid
  auditEventId     String   @unique(map: "workspace_shared_retractions_audit_event_id_key") @map("audit_event_id") @db.Uuid
  reason           String   @db.Text
  retractedAt      DateTime @default(now()) @map("retracted_at") @db.Timestamptz(6)

  publication WorkspaceSharedPublication @relation(fields: [tenantId, projectId, publicationId], references: [tenantId, projectId, id], onDelete: Restrict, map: "workspace_shared_retractions_publication_scope_fkey")
  retractor   WorkspaceStaffMembership @relation("SharedRetractors", fields: [retractedByStaffId], references: [principalId], onDelete: Restrict, map: "workspace_shared_retractions_retractor_fkey")
  audit       WorkspaceAuditEvent @relation("SharingRetractedAudit", fields: [tenantId, projectId, auditEventId], references: [tenantId, projectId, id], onDelete: Restrict, map: "workspace_shared_retractions_audit_scope_fkey")

  @@map("workspace_shared_retractions")
}
